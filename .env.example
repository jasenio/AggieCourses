POSTGRES_DB=course_recommender
POSTGRES_USER=course_recommender
# Replace before deployment; do not commit a real password.
POSTGRES_PASSWORD=change-this-before-deploying
DATABASE_URL=postgresql://course_recommender:change-this-before-deploying@localhost:5432/course_recommender
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
HTTP_PORT=8080
HTTPS_PORT=8443
# Set on Lightsail after publishing the image to GHCR. Leave unset for local builds.
# APP_IMAGE=ghcr.io/jasenio/aggiecourses:latest
